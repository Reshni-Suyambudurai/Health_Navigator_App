// Patient AI Health Navigator — Updated complete MVP database schema (DBML)
// Includes updated outreach and appointment tables plus check-in, appointment-action, and follow-up tables.
// Review notes:
// - Enum-like varchar fields list the currently proposed allowed values in comments; enforce with DB ENUM/CHECK/lookup tables in implementation.
// - Clinical guardrails must be deterministically enforced in application logic; Markdown is supporting guidance, not executable policy by itself.
// - FHIR remains the clinical source of truth; store external FHIR identifiers rather than duplicating all clinical records here.
// - This MVP uses one primary role per user. If staff can hold multiple roles, add a user_roles junction table.
// - Use UTC timestamps consistently and apply organization/patient-level authorization to all clinical records.


Table organizations {
  organization_id bigint [primary key]
  organization_name varchar
  organization_type varchar // HOSPITAL, CLINIC, HEALTHCARE_GROUP, PAYER, ACO
  npi_number varchar
  address varchar
  phone varchar
  status varchar // ACTIVE, INACTIVE
  created_at timestamp
  updated_at timestamp
}

Table roles {
  role_id bigint [primary key]
  role_name varchar // PATIENT, CARE_MANAGER, TRANSITIONAL_CARE_NURSE, PHARMACIST, SOCIAL_WORKER, POPULATION_HEALTH_MANAGER, CLINICAL_GOVERNANCE, SYSTEM_ADMIN
  description varchar
  created_at timestamp
}

Table users {
  user_id bigint [primary key]
  organization_id bigint
  role_id bigint
  first_name varchar
  last_name varchar
  email varchar
  password_hash varchar
  phone varchar
  status varchar // ACTIVE, INACTIVE, SUSPENDED
  is_verified boolean
  last_login_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table patient_profiles {
  patient_id bigint [primary key]
  user_id bigint
  external_fhir_patient_id varchar
  date_of_birth date
  gender varchar // FEMALE, MALE, NON_BINARY, OTHER, UNKNOWN, NOT_DISCLOSED (align with FHIR/organization policy)
  preferred_language varchar
  preferred_contact_method varchar // SMS, EMAIL, PHONE, PORTAL
  emergency_contact_name varchar
  emergency_contact_phone varchar
  risk_tier varchar // LOW, MEDIUM, HIGH, CRITICAL, UNKNOWN
  created_at timestamp
  updated_at timestamp
}

Table staff_profiles {
  staff_id bigint [primary key]
  user_id bigint
  employee_id varchar
  license_number varchar
  license_type varchar
  department varchar
  specialization varchar
  created_at timestamp
  updated_at timestamp
}

Ref: users.organization_id > organizations.organization_id
Ref: users.role_id > roles.role_id
Ref: patient_profiles.user_id > users.user_id
Ref: staff_profiles.user_id > users.user_id


Table patient_consent_records {
  consent_id bigint [primary key]
  patient_id bigint
  consent_type varchar // AI_DISCLOSURE, AI_INTERACTION, OUTREACH, DATA_USE
  consent_status varchar // ACCEPTED, DECLINED, REVOKED, PENDING
  consent_text_version varchar
  effective_at timestamp
  revoked_at timestamp
  captured_channel varchar // PORTAL, SMS, PHONE, IN_PERSON
  captured_by_user_id bigint
  created_at timestamp
}

Table patient_enrollments {
  enrollment_id bigint [primary key]
  patient_id bigint
  organization_id bigint
  enrollment_program varchar // TCM, APCM, RPM, CHRONIC_CARE
  enrollment_status varchar // ACTIVE, INACTIVE, COMPLETED, WITHDRAWN
  enrollment_date timestamp
  close_date timestamp
  closed_reason varchar
  created_by_user_id bigint
  created_at timestamp
  updated_at timestamp
}

Table care_navigation_episodes {
  episode_id bigint [primary key]
  patient_id bigint
  enrollment_id bigint
  episode_type varchar // POST_DISCHARGE_30_DAY, MEDICATION_SUPPORT, CHRONIC_CARE_FOLLOWUP, APPOINTMENT_FOLLOWUP, GENERAL_NAVIGATION
  trigger_type varchar // DISCHARGE, PATIENT_REQUEST, MEDICATION_CONCERN, SCHEDULED_OUTREACH, STAFF_REFERRAL
  trigger_reference varchar
  status varchar // OPEN, IN_PROGRESS, ON_HOLD, COMPLETED, CLOSED
  opened_at timestamp
  closed_at timestamp
  owner_staff_id bigint
  created_at timestamp
  updated_at timestamp
}

Ref: patient_consent_records.patient_id > patient_profiles.patient_id
Ref: patient_consent_records.captured_by_user_id > users.user_id
Ref: patient_enrollments.patient_id > patient_profiles.patient_id
Ref: patient_enrollments.organization_id > organizations.organization_id
Ref: patient_enrollments.created_by_user_id > users.user_id
Ref: care_navigation_episodes.patient_id > patient_profiles.patient_id
Ref: care_navigation_episodes.enrollment_id > patient_enrollments.enrollment_id
Ref: care_navigation_episodes.owner_staff_id > staff_profiles.staff_id


Table conversation_threads {
  thread_id bigint [primary key]
  patient_id bigint
  episode_id bigint
  channel varchar // SMS, WEB, PORTAL, PHONE
  language varchar // BCP-47 language tag, e.g. en-US; not a fixed enum
  started_at timestamp
  ended_at timestamp
  status varchar // ACTIVE, COMPLETED, ABANDONED
  created_at timestamp
}

Table conversation_messages {
  message_id bigint [primary key]
  thread_id bigint
  sender_type varchar // PATIENT, AI, STAFF, SYSTEM
  sender_user_id bigint
  ai_model_name varchar
  ai_model_version varchar
  message_text text
  message_intent varchar // e.g. APPOINTMENT_QUESTION, MEDICATION_CONCERN, SYMPTOM_REPORT, DISCHARGE_INSTRUCTIONS, HUMAN_HELP_REQUEST, OTHER; preferably controlled taxonomy
  readability_grade integer // Optional readability score/grade; define the scoring method if used
  is_guardrail_override boolean // true only when an authorized override is explicitly applied
  message_metadata json
  sent_at timestamp
}

Table clinical_guardrail {
  guardrail_id bigint [primary key]
  guardrail_name varchar
  guardrail_markdown text
  created_at timestamp
  updated_at timestamp
}

Table clinical_guardrail_rules {
  rule_id bigint [primary key]
  guardrail_id bigint
  rule_name varchar
  rule_category varchar // EMERGENCY, MEDICATION, SYMPTOM, PRIVACY, CLINICAL_SCOPE
  urgency_level varchar // ROUTINE, SAME_DAY, EMERGENCY
  handler_role_id bigint // Default handling role; nullable if not applicable
  action_type varchar // SAFE_RESPOND, BLOCK_RESPONSE, ESCALATE, EMERGENCY_PROTOCOL
  status varchar // DRAFT, ACTIVE, INACTIVE, RETIRED
  created_at timestamp
  updated_at timestamp
}

Ref: clinical_guardrail_rules.guardrail_id > clinical_guardrail.guardrail_id
Ref: clinical_guardrail_rules.handler_role_id > roles.role_id

Table conversation_guardrail_hits {
  guardrail_hit_id bigint [primary key]
  thread_id bigint
  message_id bigint
  patient_id bigint
  rule_id bigint
  hit_urgency_level varchar // ROUTINE, SAME_DAY, EMERGENCY
  action_taken varchar // SAFE_RESPOND, BLOCK_RESPONSE, ESCALATE, EMERGENCY_PROTOCOL
  hit_reason text
  created_at timestamp
}

Ref: conversation_guardrail_hits.thread_id > conversation_threads.thread_id
Ref: conversation_guardrail_hits.message_id > conversation_messages.message_id
Ref: conversation_guardrail_hits.patient_id > patient_profiles.patient_id
Ref: conversation_guardrail_hits.rule_id > clinical_guardrail_rules.rule_id

Table emergency_events {
  emergency_event_id bigint [primary key]
  patient_id bigint
  thread_id bigint
  guardrail_hit_id bigint
  emergency_type varchar // CHEST_PAIN, BREATHING_DIFFICULTY, STROKE_SIGNS, SELF_HARM_RISK, OTHER; define approved clinical categories
  emergency_instruction_sent boolean
  notified_care_team boolean
  event_status varchar // DETECTED, ESCALATED, ACKNOWLEDGED, RESOLVED
  detected_at timestamp
  resolved_at timestamp
  created_at timestamp
}

Ref: conversation_threads.patient_id > patient_profiles.patient_id
Ref: conversation_threads.episode_id > care_navigation_episodes.episode_id
Ref: conversation_messages.thread_id > conversation_threads.thread_id
Ref: conversation_messages.sender_user_id > users.user_id


Table care_team_queues {
  queue_id bigint [primary key]
  organization_id bigint
  queue_name varchar
  queue_type varchar // NURSE, PHARMACIST, CARE_MANAGER, SOCIAL_WORKER
  sla_minutes integer
  status varchar // ACTIVE, INACTIVE
  created_at timestamp
}

Table queue_memberships {
  queue_membership_id bigint [primary key]
  queue_id bigint
  staff_id bigint
  role_in_queue varchar // PRIMARY, SECONDARY, SUPERVISOR
  is_active boolean
  created_at timestamp
}

Table escalations {
  escalation_id bigint [primary key]
  patient_id bigint
  episode_id bigint
  thread_id bigint
  guardrail_hit_id bigint
  queue_id bigint
  escalation_type varchar // EMERGENCY, MEDICATION, CLINICAL, APPOINTMENT, SOCIAL, OPERATIONAL
  priority varchar // LOW, MEDIUM, HIGH, CRITICAL
  reason text
  patient_summary text
  status varchar // OPEN, ASSIGNED, IN_PROGRESS, WAITING, RESOLVED, CLOSED
  created_at timestamp
  resolved_at timestamp
}

Table escalation_assignments {
  assignment_id bigint [primary key]
  escalation_id bigint
  assigned_to_staff_id bigint
  assigned_by_user_id bigint
  assigned_at timestamp
  unassigned_at timestamp
  is_active boolean
}

Table escalation_actions {
  escalation_action_id bigint [primary key]
  escalation_id bigint
  action_by_user_id bigint
  action_type varchar // REVIEW, CALL_ATTEMPT, PATIENT_CONTACTED, MESSAGE_SENT, REFERRED, RESOLVED, OTHER
  action_notes text
  action_at timestamp
}

Ref: care_team_queues.organization_id > organizations.organization_id
Ref: queue_memberships.queue_id > care_team_queues.queue_id
Ref: queue_memberships.staff_id > staff_profiles.staff_id
Ref: escalations.patient_id > patient_profiles.patient_id
Ref: escalations.episode_id > care_navigation_episodes.episode_id
Ref: escalations.thread_id > conversation_threads.thread_id
Ref: escalations.guardrail_hit_id > conversation_guardrail_hits.guardrail_hit_id
Ref: escalations.queue_id > care_team_queues.queue_id
Ref: escalation_assignments.escalation_id > escalations.escalation_id
Ref: escalation_assignments.assigned_to_staff_id > staff_profiles.staff_id
Ref: escalation_assignments.assigned_by_user_id > users.user_id
Ref: escalation_actions.escalation_id > escalations.escalation_id
Ref: escalation_actions.action_by_user_id > users.user_id



Table outreach_campaigns {
  campaign_id bigint [primary key, increment]
  organization_id bigint [not null]
  campaign_name varchar(255) [not null]
  campaign_type varchar(50) [not null] // POST_DISCHARGE, CHRONIC_CARE, MEDICATION_FOLLOWUP, APPOINTMENT_REMINDER
  target_cohort_definition json
  timezone varchar(100) [not null, default: 'UTC']
  start_at timestamp
  end_at timestamp
  status varchar(20) [not null, default: 'DRAFT'] // DRAFT, ACTIVE, PAUSED, COMPLETED, ARCHIVED
  created_by_user_id bigint [not null]
  updated_by_user_id bigint
  created_at timestamp [not null]
  updated_at timestamp
}

Table outreach_workflows {
  workflow_id bigint [primary key, increment]
  campaign_id bigint [not null]
  step_order integer [not null]
  step_name varchar(255) [not null]
  trigger_type varchar(50) [not null] // AFTER_DISCHARGE, BEFORE_APPOINTMENT, AFTER_EVENT
  trigger_anchor varchar(50) [not null] // DISCHARGE_DATETIME, APPOINTMENT_DATETIME, EVENT_DATETIME
  trigger_offset_hours integer [not null, default: 0]
  channel varchar(20) [not null] // SMS, EMAIL, PHONE, PORTAL
  template_text text
  checkin_template_id bigint
  escalation_on_no_response boolean [not null, default: false]
  max_attempts integer [not null, default: 3]
  retry_interval_minutes integer [not null, default: 30]
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
  updated_at timestamp

  indexes {
    (campaign_id, step_order) [unique]
  }

  checks {
    `step_order > 0` [name: 'chk_workflow_step_order']
    `trigger_offset_hours >= 0` [name: 'chk_trigger_offset']
    `max_attempts > 0` [name: 'chk_max_attempts']
    `retry_interval_minutes >= 0` [name: 'chk_retry_interval']
  }
}

Table outreach_events {
  outreach_event_id bigint [primary key, increment]
  patient_id bigint [not null]
  episode_id bigint
  campaign_id bigint [not null]
  workflow_id bigint [not null]
  appointment_id bigint
  channel varchar(20) [not null] // SMS, EMAIL, PHONE, PORTAL
  event_type varchar(40) [not null] // CHECK_IN, APPOINTMENT_REMINDER, REFILL_REMINDER, FOLLOW_UP
  event_status varchar(20) [not null, default: 'PENDING'] // PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED
  delivery_status varchar(20) [not null, default: 'PENDING'] // PENDING, SENT, DELIVERED, FAILED, RESPONDED
  scheduled_at timestamp [not null]
  sent_at timestamp
  responded_at timestamp
  completed_at timestamp
  attempt_count integer [not null, default: 0]
  last_error text
  idempotency_key varchar(255) [not null, unique]
  created_at timestamp [not null]
  updated_at timestamp

  indexes {
    (event_status, scheduled_at)
    (patient_id, episode_id)
    (campaign_id, workflow_id)
  }

  checks {
    `attempt_count >= 0` [name: 'chk_outreach_attempt_count']
  }
}

Ref: outreach_campaigns.organization_id > organizations.organization_id
Ref: outreach_campaigns.created_by_user_id > users.user_id
Ref: outreach_campaigns.updated_by_user_id > users.user_id
Ref: outreach_workflows.campaign_id > outreach_campaigns.campaign_id
Ref: outreach_workflows.checkin_template_id > checkin_templates.checkin_template_id
Ref: outreach_events.patient_id > patient_profiles.patient_id
Ref: outreach_events.episode_id > care_navigation_episodes.episode_id
Ref: outreach_events.campaign_id > outreach_campaigns.campaign_id
Ref: outreach_events.workflow_id > outreach_workflows.workflow_id
Ref: outreach_events.appointment_id > appointments.appointment_id


// Additional foreign-key relationships for MVP integrity
Ref: emergency_events.patient_id > patient_profiles.patient_id
Ref: emergency_events.thread_id > conversation_threads.thread_id
Ref: emergency_events.guardrail_hit_id > conversation_guardrail_hits.guardrail_hit_id

Table staff_availability {
  availability_id bigint [primary key, increment]
  staff_id bigint [not null]

  day_of_week varchar(10) [not null]
  start_time time [not null]
  end_time time [not null]

  lunch_start_time time
  lunch_end_time time

  effective_from date [not null]
  effective_until date
  is_active boolean [not null, default: true]

  created_at timestamp [not null]
  updated_at timestamp

  checks {
    `start_time < end_time` [name: 'chk_availability_time']
    `(lunch_start_time IS NULL AND lunch_end_time IS NULL) OR (lunch_start_time IS NOT NULL AND lunch_end_time IS NOT NULL AND lunch_start_time < lunch_end_time AND lunch_start_time >= start_time AND lunch_end_time <= end_time)` [name: 'chk_lunch_time']
  }
}

Table appointments {
  appointment_id bigint [primary key, increment]
  patient_id bigint [not null]
  staff_id bigint
  episode_id bigint
  source_outreach_event_id bigint
  appointment_type varchar(50) [not null] // POST_DISCHARGE, NURSE_FOLLOWUP, CARE_MANAGER_CALL
  appointment_datetime timestamp [not null]
  end_datetime timestamp [not null]
  status varchar(20) [not null, default: 'REQUESTED'] // REQUESTED, SCHEDULED, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW, RESCHEDULED
  booking_method varchar(30) [not null] // STAFF, PATIENT_PORTAL, EHR_INTEGRATION
  location_or_channel varchar(255)
  reason text
  cancellation_reason text
  rescheduled_from_appointment_id bigint
  created_by_user_id bigint [not null]
  external_fhir_appointment_id varchar(255)
  created_at timestamp [not null]
  updated_at timestamp

  indexes {
    (staff_id, appointment_datetime, end_datetime)
    (patient_id, appointment_datetime)
    (episode_id)
  }

  checks {
    `appointment_datetime < end_datetime` [name: 'chk_appointment_time']
  }
}

// Relationships to existing tables
Ref: staff_availability.staff_id > staff_profiles.staff_id
Ref: appointments.patient_id > patient_profiles.patient_id
Ref: appointments.staff_id > staff_profiles.staff_id
Ref: appointments.episode_id > care_navigation_episodes.episode_id
Ref: appointments.created_by_user_id > users.user_id
Ref: appointments.source_outreach_event_id > outreach_events.outreach_event_id
Ref: appointments.rescheduled_from_appointment_id > appointments.appointment_id



//////////////////////////////////////////////////////
// CHECK-IN CONFIGURATION AND PATIENT RESPONSES
//////////////////////////////////////////////////////

Table checkin_templates {
  checkin_template_id bigint [primary key, increment]
  organization_id bigint [not null]
  template_name varchar(255) [not null]
  template_type varchar(50) [not null] // POST_DISCHARGE, CHRONIC_CARE, MEDICATION_FOLLOWUP
  description text
  version integer [not null, default: 1]
  status varchar(20) [not null, default: 'DRAFT'] // DRAFT, ACTIVE, INACTIVE
  created_by_user_id bigint [not null]
  created_at timestamp [not null]
  updated_at timestamp

  indexes {
    (organization_id, template_name, version) [unique]
  }
}

Table checkin_questions {
  question_id bigint [primary key, increment]
  checkin_template_id bigint [not null]
  question_key varchar(100) [not null]
  question_text text [not null]
  answer_type varchar(30) [not null] // YES_NO, TEXT, NUMBER, SINGLE_CHOICE, MULTIPLE_CHOICE
  options json
  display_order integer [not null]
  is_required boolean [not null, default: true]
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
  updated_at timestamp

  indexes {
    (checkin_template_id, question_key) [unique]
    (checkin_template_id, display_order) [unique]
  }

  checks {
    `display_order > 0` [name: 'chk_question_display_order']
  }
}

Table checkin_sessions {
  checkin_session_id bigint [primary key, increment]
  patient_id bigint [not null]
  episode_id bigint
  outreach_event_id bigint [not null, unique]
  checkin_template_id bigint [not null]
  thread_id bigint
  session_status varchar(20) [not null, default: 'PENDING'] // PENDING, IN_PROGRESS, COMPLETED, ABANDONED, ESCALATED
  started_at timestamp
  completed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp

  indexes {
    (patient_id, episode_id)
    (session_status, created_at)
  }
}

Table checkin_responses {
  response_id bigint [primary key, increment]
  checkin_session_id bigint [not null]
  question_id bigint [not null]
  message_id bigint
  answer_text text
  answer_value json
  response_source varchar(30) [not null, default: 'PATIENT_REPORTED'] // PATIENT_REPORTED, STAFF_ENTERED
  recorded_by_user_id bigint
  answered_at timestamp [not null]
  created_at timestamp [not null]

  indexes {
    (checkin_session_id, question_id) [unique]
  }
}

//////////////////////////////////////////////////////
// APPOINTMENT ACTIONS AND FOLLOW-UP TASKS
//////////////////////////////////////////////////////

Table appointment_actions {
  appointment_action_id bigint [primary key, increment]
  appointment_id bigint [not null]
  patient_id bigint [not null]
  episode_id bigint
  action_by_user_id bigint [not null]
  contact_datetime timestamp
  contact_method varchar(30) // PHONE, PORTAL, SMS, VIDEO, IN_PERSON, INTERNAL_REVIEW
  action_taken varchar(50) [not null] // REVIEWED, CALL_ATTEMPT, PATIENT_CONTACTED, GUIDANCE_PROVIDED, REFERRED, OTHER
  outcome varchar(50) // REACHED, NO_ANSWER, ISSUE_ADDRESSED, ISSUE_UNRESOLVED, REFERRED, OTHER
  action_notes text
  resolution_status varchar(30) [not null, default: 'PENDING'] // PENDING, RESOLVED, FOLLOW_UP_REQUIRED, UNABLE_TO_REACH
  follow_up_required boolean [not null, default: false]
  follow_up_notes text
  follow_up_due_at timestamp
  created_at timestamp [not null]
  updated_at timestamp

  indexes {
    (appointment_id, created_at)
    (patient_id, episode_id)
    (resolution_status, follow_up_due_at)
  }
}

Table follow_up_tasks {
  follow_up_task_id bigint [primary key, increment]
  patient_id bigint [not null]
  episode_id bigint
  appointment_id bigint
  escalation_id bigint
  task_type varchar(50) [not null] // PATIENT_CONTACT, MEDICATION_FOLLOWUP, APPOINTMENT_BOOKING, CLINICAL_REVIEW, OTHER
  title varchar(255) [not null]
  description text
  assigned_to_staff_id bigint
  created_by_user_id bigint
  due_at timestamp
  priority varchar(20) [not null, default: 'MEDIUM'] // LOW, MEDIUM, HIGH, CRITICAL
  status varchar(20) [not null, default: 'OPEN'] // OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  completed_by_user_id bigint
  completed_at timestamp
  completion_notes text
  created_at timestamp [not null]
  updated_at timestamp

  indexes {
    (status, due_at)
    (assigned_to_staff_id, status, due_at)
    (patient_id, episode_id)
  }
}

// New table relationships
Ref: checkin_templates.organization_id > organizations.organization_id
Ref: checkin_templates.created_by_user_id > users.user_id
Ref: checkin_questions.checkin_template_id > checkin_templates.checkin_template_id
Ref: checkin_sessions.patient_id > patient_profiles.patient_id
Ref: checkin_sessions.episode_id > care_navigation_episodes.episode_id
Ref: checkin_sessions.outreach_event_id > outreach_events.outreach_event_id
Ref: checkin_sessions.checkin_template_id > checkin_templates.checkin_template_id
Ref: checkin_sessions.thread_id > conversation_threads.thread_id
Ref: checkin_responses.checkin_session_id > checkin_sessions.checkin_session_id
Ref: checkin_responses.question_id > checkin_questions.question_id
Ref: checkin_responses.message_id > conversation_messages.message_id
Ref: checkin_responses.recorded_by_user_id > users.user_id
Ref: appointment_actions.appointment_id > appointments.appointment_id
Ref: appointment_actions.patient_id > patient_profiles.patient_id
Ref: appointment_actions.episode_id > care_navigation_episodes.episode_id
Ref: appointment_actions.action_by_user_id > users.user_id
Ref: follow_up_tasks.patient_id > patient_profiles.patient_id
Ref: follow_up_tasks.episode_id > care_navigation_episodes.episode_id
Ref: follow_up_tasks.appointment_id > appointments.appointment_id
Ref: follow_up_tasks.escalation_id > escalations.escalation_id
Ref: follow_up_tasks.assigned_to_staff_id > staff_profiles.staff_id
Ref: follow_up_tasks.created_by_user_id > users.user_id
Ref: follow_up_tasks.completed_by_user_id > users.user_id


Table audit_logs {
  audit_id bigint [primary key]
  user_id bigint
  patient_id bigint
  action varchar // e.g. CREATE, READ, UPDATE, DELETE, LOGIN, EXPORT, ASSIGN, RESOLVE
  resource_type varchar // e.g. USER, PATIENT, CONSENT, MESSAGE, ESCALATION, GUARDRAIL, OUTREACH
  resource_id varchar
  details json
  ip_address varchar
  correlation_id varchar
  created_at timestamp
}

Ref: audit_logs.user_id > users.user_id
Ref: audit_logs.patient_id > patient_profiles.patient_id
